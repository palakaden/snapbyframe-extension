{
  "manifest_version": 3,
  "name": "Snap by Frame",
  "version": "1.7",
  "description": "Instantly capture, annotate, and copy any specific web page element or custom region directly to your clipboard.",
  "permissions": ["activeTab", "scripting", "notifications", "downloads"],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Capture element screenshot (Alt+Shift+S)",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "commands": {
    "trigger-screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Activate element hover screenshot tool"
    }
  }
}