{
  "manifest_version": 3,
  "name": "Snap by Frame",
  "version": "2.2",
  "description": "Instantly capture or record any specific web page element or custom region, annotate in-place, and copy or save.",
  "permissions": [
    "activeTab",
    "scripting",
    "notifications",
    "downloads",
    "tabCapture",
    "offscreen"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Snap by Frame (Alt+Shift+S / Alt+Shift+R)",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "commands": {
    "trigger-screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S",
        "windows": "Alt+Shift+S"
      },
      "description": "Take screenshot"
    },
    "trigger-recording": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R",
        "windows": "Alt+Shift+R"
      },
      "description": "Record screen region"
    }
  }
}